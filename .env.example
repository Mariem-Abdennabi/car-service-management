# Example environment configuration.
#
# This file is committed as documentation and holds no real credentials.
# Copy it to `.env` for your own values — `.env` is git-ignored and must stay
# that way.
#
# On startup the application reads `.env` from the working directory, so
# `go run ./cmd/server` picks these up with no extra ceremony.
#
# A variable exported in your shell always wins over this file:
#
#     PORT=3000 go run ./cmd/server
#
# One edge case: a variable exported as *empty* (`export PORT=`) counts as set,
# so the value here is skipped and the built-in default applies. Unset it with
# `unset PORT` rather than blanking it.

# Which mode the application runs in: development | production
APP_ENV=development

# Port the HTTP server listens on (1-65535).
PORT=8080

# PostgreSQL connection string.
# Read but unused until Milestone 2, when the connection pool is added.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/car_service?sslmode=disable
