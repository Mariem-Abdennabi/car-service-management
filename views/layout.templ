package views

import "github.com/Mariem-Abdennabi/car-service-management/assets"

// Layout is the HTML shell every page renders inside.
//
// `{ children... }` is templ's slot: whatever a caller nests inside `@Layout(...)
// { ... }` is rendered there, so the head, the header, and the page furniture are
// written once.
//
// nav is which section the page belongs to — one of the Nav constants — so the
// header can mark it.
templ Layout(title, nav string, a assets.Assets) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Car Service</title>
			<link rel="stylesheet" href={ a.CSS }/>
			// type="module" because Vite outputs ES modules. defer is implied for
			// modules, which is what Alpine needs — it scans the DOM on start.
			<script type="module" src={ a.JS }></script>
		</head>
		<body class="flex min-h-full flex-col bg-slate-50 text-slate-900 antialiased">
			<header class="sticky top-0 z-10 border-b border-slate-200 bg-white/90 backdrop-blur">
				<nav class="mx-auto flex max-w-5xl items-center gap-8 px-6 py-4">
					<a href="/" class="flex items-center gap-2">
						// A wrench, so the header has a mark rather than only words.
						<span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-600 text-white">
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
							</svg>
						</span>
						<span class="text-base font-semibold tracking-tight">Car Service</span>
					</a>
					<div class="flex items-center gap-1">
						@navLink("/customers", "Customers", nav == NavCustomers)
						@navLink("/parts", "Spare parts", nav == NavParts)
					</div>
				</nav>
			</header>
			<main class="mx-auto w-full max-w-5xl flex-1 px-6 py-10">
				{ children... }
			</main>
			<footer class="border-t border-slate-200 bg-white">
				<div class="mx-auto max-w-5xl px-6 py-4 text-xs text-slate-500">
					Car Service &amp; Spare Parts Management
				</div>
			</footer>
		</body>
	</html>
}

// navLink is one header link, styled differently when it is the current section.
//
// aria-current tells a screen reader which page it is on; colour alone would say
// that only to people who can see it.
templ navLink(href, label string, current bool) {
	if current {
		<a
			href={ href }
			aria-current="page"
			class="rounded-md bg-brand-50 px-3 py-1.5 text-sm font-medium text-brand-700"
		>
			{ label }
		</a>
	} else {
		<a
			href={ href }
			class="rounded-md px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900"
		>
			{ label }
		</a>
	}
}
