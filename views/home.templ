package views

import (
	"fmt"
	"strconv"

	"github.com/Mariem-Abdennabi/car-service-management/assets"
	"github.com/Mariem-Abdennabi/car-service-management/internal/store"
)

// Home is the dashboard: what is in the system, and the two things worth acting on.
templ Home(a assets.Assets, summary store.Summary, recent []store.Customer, outOfStock []store.Part) {
	@Layout("Home", NavHome, a) {
		<div class="flex flex-wrap items-end justify-between gap-4">
			<div>
				<h1 class="text-2xl font-semibold tracking-tight">Workshop overview</h1>
				<p class="mt-1 text-sm text-slate-500">Customers, their vehicles, and what is on the shelf.</p>
			</div>
			<div class="flex gap-2">
				<a
					href="/customers/new"
					class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-brand-700"
				>
					New customer
				</a>
				<a
					href="/parts/new"
					class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50"
				>
					New part
				</a>
			</div>
		</div>
		<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			@statCard("Customers", strconv.FormatInt(summary.Customers, 10), "/customers")
			@statCard("Vehicles", strconv.FormatInt(summary.Vehicles, 10), "")
			@statCard("Spare parts", strconv.FormatInt(summary.Parts, 10), "/parts")
			@statCard("Out of stock", strconv.FormatInt(summary.OutOfStock, 10), "/parts")
		</div>
		<div class="mt-8 grid gap-6 lg:grid-cols-2">
			<section>
				<h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Recent customers</h2>
				if len(recent) == 0 {
					@EmptyState("No customers yet", "Add the first one to get started.")
				} else {
					<div class="mt-3">
						@Card() {
							<ul class="divide-y divide-slate-100">
								for _, customer := range recent {
									<li>
										<a
											href={ fmt.Sprintf("/customers/%d", customer.ID) }
											class="flex items-center justify-between px-4 py-3 transition hover:bg-slate-50"
										>
											<span class="text-sm font-medium text-slate-900">{ customer.Name }</span>
											<span class="text-sm text-slate-500">{ customer.City }</span>
										</a>
									</li>
								}
							</ul>
						}
					</div>
				}
			</section>
			<section>
				<h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Needs restocking</h2>
				if len(outOfStock) == 0 {
					@EmptyState("Everything is in stock", "")
				} else {
					<div class="mt-3">
						@Card() {
							<ul class="divide-y divide-slate-100">
								for _, part := range outOfStock {
									<li class="flex items-center justify-between px-4 py-3">
										<span>
											<span class="text-sm font-medium text-slate-900">{ part.Name }</span>
											<span class="ml-2 text-xs text-slate-500">{ part.Reference }</span>
										</span>
										<a
											href={ fmt.Sprintf("/parts/%d/edit", part.ID) }
											class="text-sm font-medium text-brand-700 hover:underline"
										>
											Restock
										</a>
									</li>
								}
							</ul>
						}
					</div>
				}
			</section>
		</div>
	}
}

// statCard is one number on the dashboard. href makes it a link when the number
// leads somewhere.
templ statCard(label, value, href string) {
	if href != "" {
		<a
			href={ href }
			class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-brand-500 hover:shadow"
		>
			@statBody(label, value)
		</a>
	} else {
		<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
			@statBody(label, value)
		</div>
	}
}

templ statBody(label, value string) {
	<p class="text-sm font-medium text-slate-500">{ label }</p>
	<p class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">{ value }</p>
}
